# Frontend runtime configuration. Defaults match the local Hardhat chain.
# No secrets belong here: everything below is public and served to the browser.

# Backend API base URL.
VITE_API_URL=http://localhost:5000/api

# JSON-RPC endpoint of the chain node.
VITE_RPC_URL=http://127.0.0.1:8545

# Comma-separated chain ids. 31337 = Hardhat local. Sepolia (11155111) and
# Mainnet (1) ONLY activate when explicitly listed here.
VITE_CHAIN_ID=31337

# Deployed ZakatVerify contract address (public information).
VITE_ZAKAT_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
