# === Authentication (WITHOUT THESE, LOGIN AND PROTECTED ROUTES RETURN 503) ===
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# SESSION_SECRET=replace-with-a-different-long-random-secret  # not used; JWT is the auth method

# === Database ===
DATABASE_PATH=./database.sqlite

# === Blockchain / RPC ===
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
ZAKAT_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_PRIVATE_KEY=

# === Payment / Webhook ===
PAYMENT_WEBHOOK_SECRET=replace-with-a-provider-shared-secret

# === Server ===
PORT=5000
# Daftar origin yang diizinkan mengakses API (dipisahkan koma; '*' ditolak karena credentials: true).
CORS_ORIGIN=http://localhost:5173
# Pengaturan trust proxy Express untuk req.ip di rate limiter ('loopback', hop count angka, 'true', atau 'false').
TRUST_PROXY=loopback
# Setel 'false' di produksi bila ingin menutup pendaftaran akun publik (/api/auth/register).
ALLOW_PUBLIC_REGISTRATION=true

# === Initial Production Admin Provisioning (opsional saat menjalankan npm run create:admin) ===
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
